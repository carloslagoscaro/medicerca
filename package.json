{
  "name": "medicerca",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Comparador de precios de medicamentos entre farmacias online y farmacias de barrio, con mapa de cercanía.",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "test": "node --test test",
    "snapshot": "node scripts/snapshot.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.0.0"
  }
}
